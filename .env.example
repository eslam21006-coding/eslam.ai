# Supabase public client configuration.
# Copy to .env.local and replace with values from the Eslam.AI Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Backend-only Supabase key for privileged server writes such as assistant messages.
# Never expose this value through NEXT_PUBLIC_* variables or browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Backend-only OpenAI configuration.
OPENAI_API_KEY=sk_replace_me
# Optional model override. The application defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Never expose Supabase secret/service-role keys or OpenAI API keys through NEXT_PUBLIC_* variables.
