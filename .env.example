# Supabase public client configuration.
# Copy to .env.local and replace with values from the Eslam.AI Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Backend-only Supabase key for privileged server writes such as assistant messages.
# Never expose this value through NEXT_PUBLIC_* variables or browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Backend-only OpenAI configuration.
OPENAI_API_KEY=sk_replace_me
# Optional chat model override. The application defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# Optional speech-to-text model override. Voice transcription defaults to gpt-4o-transcribe.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional Voice → Teaching extraction model override. Defaults to OPENAI_MODEL, then gpt-5-mini.
# OPENAI_VOICE_TEACHING_MODEL=gpt-5-mini

# Backend-only YouTube transcript acquisition.
# Task 27 uses Supadata native transcripts/captions only; it does not silently generate paid AI transcripts.
# Create a server API key in Supadata and configure the same secret in Vercel Production/Preview.
SUPADATA_API_KEY=supadata_replace_me

# Never expose Supabase secret/service-role keys, OpenAI API keys, or transcript-provider keys through NEXT_PUBLIC_* variables.
